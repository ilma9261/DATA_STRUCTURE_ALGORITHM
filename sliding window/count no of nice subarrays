// leetcode 1248

class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
     int i=0;
     int j=0;
     int n=nums.size();
     int cnt=0;
     int odd=0;
     int sum=0;
     int even=0;
     while(j<n){
      if(nums[j]%2!=0){
        odd++;
      }
      while(i<=j && (nums[i]%2==0 || odd>k)){
        if(nums[i]%2!=0){
            odd--;
            even=0;
        }
        else{
            even++;
        }
        i++;
      }
      if(odd==k){
        cnt+=1+even;
      }
      j++;
     }   
     return cnt;
    }
};
