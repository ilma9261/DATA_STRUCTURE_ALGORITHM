// leetcode 713

class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        int i=0;
        int j=0;
        int product=1;
        // Use long long to prevent potential overflow long long product = 1;
        int n=nums.size();
        int cnt=0;
        if(k<=1){
            return 0;
        }
        while(j<n){
            product*=nums[j];
            // i <= j ensures we never read out of bounds if product stays >= k
            while(i<=j && product>=k){
                product/=nums[i];
                i++;
            }
            cnt+=j-i+1;
            j++;
        }
        return cnt;
    }
};
