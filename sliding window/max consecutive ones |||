// leetcode 1004

class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int i=0;
        int j=0;
        int n=nums.size();
        int zero=0;
        int maxi=0;
        while(j<n){
            if(nums[j]==0){
                zero++;
            }
            while(zero>k){
                if(nums[i]==0){
                    zero--;
                }
                i++;
            }
             int len=j-i+1;            // check len after moving pointers not before that
             maxi=max(len,maxi);
            j++;
        }
        return maxi;
    }
};
