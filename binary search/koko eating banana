// leetcode 875

class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        
        int low=1;
        int high=INT_MIN;
        for(int x:piles){
            high=max(high,x);
        }
        while(low<high){
            int mid=low+(high-low)/2;

// We need ceiling of (x / mid), because if some bananas are left,
// Koko needs one extra hour to finish them.
// Floor = round down, Ceiling = round up.
// C++ integer division gives floor, so we use:
// ceil(x / mid) = (x + mid - 1) / mid
// Example: 10 / 3 = 3.33 → ceiling = 4
// (10 + 3 - 1) / 3 = 12 / 3 = 4

int hours=0;
for(int x:piles){
    hours+=(x+mid-1)/mid;        // Adding mid - 1 makes any non-zero remainder count as one extra
}

            if(h<hours){
                low=mid+1;
            }
            else{
                  high=mid;
            }
        }
        return high;       // at the end of the binary search, low and high become equal so we can return anything
    }
};
