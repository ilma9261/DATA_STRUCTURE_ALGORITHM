class Solution {
public:
    int firstBadVersion(int n) {
        int low=1;
        int high=n;
        while(low<high){
            int mid=low+(high-low)/2;     //runtime error
            if(isBadVersion(mid)){
                high=mid;
            }
            else{                       // using else instead of (!isBadVersion(mid)) bcz APT might have limited calls allowed
              low=mid+1;
            }
        }
        return high;                 // we can return low also
    }
};
