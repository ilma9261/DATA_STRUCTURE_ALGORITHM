// peak index in a mountain array

//1

class Solution {
public;
    int peakIndexInMountainArray(vector<int>& arr) {
        int n=arr.size();
        int low=0;
        int high=n-1;
        int res=0;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]<arr[mid+1]){
                low=mid+1;
            }
            if(arr[mid]>arr[mid+1]){
                res=mid;
                high=mid-1;
            }
        }
        return res;
    }
};

// 2

class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {
        int n=arr.size();
        int low=0;
        int high=n-1;
        while(low<high){                     // low<high not low<=high cz we are checking mid+1
            int mid=(low+high)/2; 
            if(arr[mid]<arr[mid+1]){
                low=mid+1;
            }
            if(arr[mid]>arr[mid+1]){
                high=mid;
            }
        }
        return high;
    }
};




// leetcode 162

// find peak element

class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int n=nums.size();
        int low=0;
        int high=n-1;
        while(low<high){
            int mid=low+(high-low)/2;
            if(nums[mid]>nums[mid+1]){
                high=mid;
            }
            else{
                low=mid+1;
            }
        }
        return high;
    }
};
