// leetcode 1051

class Solution {
public:
    int heightChecker(vector<int>& heights) {
        int n=heights.size();
        vector<int> v=heights;                    // direct vector copy
        sort(v.begin(),v.end());
        int cnt=0;
        for(int i=0;i<n;i++){
            if(heights[i]!=v[i]){
                cnt++;
            }
        }
        return cnt;
    }
};
