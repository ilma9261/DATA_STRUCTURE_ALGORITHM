// leetcode 1732

class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int highest=0;
        int n=gain.size();
         int current=0;
        for(int i=0;i<n;i++){
            current+=gain[i];
            highest=max(highest,current);
        }
        return highest;
    }
};
