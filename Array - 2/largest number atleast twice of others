// leetcode 747

class Solution {
public:
    int dominantIndex(vector<int>& nums) {
        int n=nums.size();
        int largest=nums[0];
        int second_largest=INT_MIN;
        int index=0;
        for(int i=1;i<n;i++){
            if(nums[i]>largest){
                second_largest=largest;
                largest=nums[i];
                index=i;
            }
            if(nums[i]<largest && nums[i]>second_largest){
                second_largest=nums[i];
            }
        }
        if(largest>=2*second_largest){
            return index;
        }
        else{
            return -1;
        }
    }
};
