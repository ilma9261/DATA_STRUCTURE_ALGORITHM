// leetcode 350

class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {
        vector<int> v;
            int n=nums1.size();
            int m=nums2.size();
            unordered_map<int,int> mp;         // we can use sorting + two pointer to optimise space
            for(int i=0;i<n;i++){
            mp[nums1[i]]++;
            }
            for(int i=0;i<m;i++){
                if(mp.find(nums2[i])!=mp.end() && mp[nums2[i]]!=0){
                    v.push_back(nums2[i]);
                    mp[nums2[i]]--;
                }
            }
            return v;
    }
};

// to opmise space we can use sorting+two pointer

class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {

        vector<int> v;

        sort(nums1.begin(), nums1.end());
        sort(nums2.begin(), nums2.end());

        int i = 0;
        int j = 0;

        while(i < nums1.size() && j < nums2.size()) {

            if(nums1[i] == nums2[j]) {
                v.push_back(nums1[i]);
                i++;
                j++;
            }
            else if(nums1[i] < nums2[j]) {
                i++;
            }
            else {
                j++;
            }
        }

        return v;
    }
};
