// leetcode 349

class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
            vector<int> v;
            int n=nums1.size();
            int m=nums2.size();
            unordered_map<int,int> mp;         // we can use sorting + two pointer to optimise space
            for(int i=0;i<n;i++){
            mp[nums1[i]]++;
            }
            for(int i=0;i<m;i++){
                if(mp.find(nums2[i])!=mp.end()){
                    v.push_back(nums2[i]);
                    mp.erase(nums2[i]);
                }
            }
            return v;
    }
};
