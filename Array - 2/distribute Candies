// leetcode 575

class Solution {
public:
    int distributeCandies(vector<int>& candyType) {
        int n=candyType.size();
        unordered_set<int> st(candyType.begin(),candyType.end());
        int type=st.size();
        int k=n/2;
        if(k>=type){
            return type;
        }
        else{
            return k;
        }
    }
};
