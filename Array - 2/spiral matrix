// leetcode 54

class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        int m=matrix.size();
        int n=matrix[0].size();
        int i=0;
        int j=-1;
        int dir=1;
        vector<int> v;
        while(m>0 && n>0){
            for(int k=0;k<n;k++){
                j+=dir;
                v.push_back(matrix[i][j]);
            }
            m--;
            for(int k=0;k<m;k++){
                i+=dir;
                v.push_back(matrix[i][j]);
            }
            n--;
            dir=-1*dir;
        }
        return v;
    }
};
