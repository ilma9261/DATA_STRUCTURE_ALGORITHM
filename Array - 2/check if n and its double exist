// leetcode 1346
// I SOLVED IT USING HASHMAP FIRST BUT THEN I HAD TO OPYIMISE IT USING HASHSET BECAUSE WE CAN SOLVE IT USING HASHSET IN SINGLE PASS but yes 
we can use hashmap for single pass too 

// HASHMAP TWO PASS

class Solution {
public:
    bool checkIfExist(vector<int>& arr) {
        unordered_map<int,int> mp;
        int n=arr.size();
        for(int i=0;i<n;i++){
            mp[arr[i]]=i;
        }
        for(int i=0;i<n;i++){
            int target=2*arr[i];
            if(mp.find(target)!=mp.end() && mp[target]!=i){
                return true;
            }
        }
        return false;
    }
};

// HASHMAP SINGLE PASS

class Solution {
public:
    bool checkIfExist(vector<int>& arr) {
        unordered_map<int,int> mp;
        int n=arr.size();
        for(int i=0;i<n;i++){
            if(mp.find(2*arr[i])!=mp.end() || (arr[i]%2==0 && mp.find(arr[i]/2)!=mp.end())){
                return true;
            }
            mp[arr[i]]++;         // mp[arr[i]]=i
        }
        return false;
    }
};

// HASHSET

class Solution {
public:
    bool checkIfExist(vector<int>& arr) {
        unordered_set<int> st;
        int n=arr.size();
        for(int i=0;i<n;i++){
            if(st.count(2*arr[i]) || (arr[i]%2==0 && st.count(arr[i]/2))){
                return true;
            }
            st.insert(arr[i]);
        }
        return false;
    }
};
