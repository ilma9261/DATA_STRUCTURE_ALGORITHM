// leetcode 1295

class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int n=nums.size();
       int i=0;
       int ans=0;
       while(i<n){
        int k=nums[i];
        int cnt=0;
        while(k>0){
            cnt++;
           k = k/10;
        }
        if(cnt%2==0){
            ans++;
        }
        i++;
       }
       return ans;
    }
};
