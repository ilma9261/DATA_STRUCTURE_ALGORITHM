// leetcode 628

// BRUTE FORCE

class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int n=nums.size();
            int product1=nums[n-1]*nums[n-2]*nums[n-3];
            int product2=nums[n-1]*nums[0]*nums[1];
            int product=max(product1,product2);
            return product;
        
    }
};

//OPTIMAL

class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        int n=nums.size();
        int min1=INT_MAX;
        int min2=INT_MAX;
        int max1=INT_MIN;
        int max2=INT_MIN;
        int max3=INT_MIN;
        for(int i=0;i<n;i++){
            if(nums[i]>=max1){
                max3=max2;
                max2=max1;
                max1=nums[i];
            }
            else if(nums[i]<max1 && nums[i]>=max2){
                 max3=max2;
                max2=nums[i];
            }
            else if(nums[i]<max2 && nums[i]>=max3){
                max3=nums[i];
            }
            if(nums[i]<=min1){
                min2=min1;
                min1=nums[i];
            }
            else if(nums[i]>min1 && nums[i]<min2){
                min2=nums[i];
            }
        }
       int product1=max1*max2*max3;
       int product2=max1*min1*min2;
        int product=max(product1,product2);
        return product;
    }
};
