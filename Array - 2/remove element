class Solution {
public:
    int removeElement(vector<int>& nums, int val) {

        int i = 0;

        for(int j = 0; j < nums.size(); j++) {

            if(nums[j] != val) {
                nums[i] = nums[j];
                i++;
            }
        }                                 // You're confused because you're thinking that removing an element means decreasing the vector's actual size.

But in this question, we don't actually shrink the vector! We only overwrite its elements.

        return i;
    }
};
