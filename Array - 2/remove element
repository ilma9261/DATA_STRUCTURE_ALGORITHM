// THIS IS MY APPROACH NOT STANSARD ONE , IT CHANGES THE ORDER BUT THAT DOES NOT MATTER FOR QUESTION . 

class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
       int n=nums.size();
      int i=0;
      while(i<n){
        if(nums[i]==val){
          nums[i]=nums[n-1];
          n--;
        }
        else{
            i++;
        }
      }
      return n;
    }
};


