// leetcode 1299

// 2 APPROACHES

class Solution {
public:
    vector<int> replaceElements(vector<int>& arr) {
        int n=arr.size();
        int maxi=arr[n-1];
        vector<int> v;
        for(int i=n-1;i>=0;i--){
            if(i==n-1){
                v.push_back(-1);
            }
            else{
                v.push_back(maxi);
            }
            if(arr[i]>maxi){
                maxi=arr[i];
            }
        }
        reverse(v.begin(),v.end());           // time - o(n) , space  - o(1)
        return v;
    }
};

// TWO MODIFY ARRAY INPLACE

class Solution {
public:
    vector<int> replaceElements(vector<int>& arr) {
        int n=arr.size();
        int maxi=arr[n-1];
        arr[n-1]=-1;
        for(int i=n-2;i>=0;i--){
            int temp=maxi;
             if(arr[i]>maxi){
                maxi=arr[i];
            }
            arr[i]=temp;
        }
        return arr;
    }
};
