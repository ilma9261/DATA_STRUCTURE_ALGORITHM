class Solution {
public:
    vector<vector<int>> minimumAbsDifference(vector<int>& arr) {
        vector<vector<int>> v;
// Whenever a question asks you to find the minimum or maximum difference between pairs of numbers, consider sorting first.

It is not compulsory in every such problem, but sorting often makes the solution much easier.

        sort(arr.begin(),arr.end());
        int n=arr.size();
        int diff=INT_MAX;
        int i=0;
        int j=1;
       while(i<n && j<n){
        int k=arr[j]-arr[i];
        if(k<diff){
            diff=k;
            v.clear();
           v.push_back({arr[i],arr[j]});
        }
        else if(k==diff){
            v.push_back({arr[i],arr[j]});
        }
        i++;
        j++;
       }
       return v;
    }
};
