// leetcode 67

class Solution {
public:
    string addBinary(string a, string b) {
        int carry=0;
        string ans="";
        int i=a.size()-1;
        int j=b.size()-1;
        int sum=0;

        // Almost — not both. The operator matters:

       // -'0' → character → digit (integer)
        // +'0' → digit (integer) → character

        while(i>=0 || j>=0 || carry!=0){
            sum=carry;
            if(i>=0){
                sum+=a[i]-'0';
                i--;
            }
            if(j>=0){
                sum+=b[j]-'0';
                j--;
            }
            ans+=to_string(sum%2);        // ans+=(sum%2)+'0'
            carry=sum/2;
        }
        reverse(ans.begin(),ans.end());

        // Space complexity = output space + auxiliary space
        
        return ans;
    }
};
