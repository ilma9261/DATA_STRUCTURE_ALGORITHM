// OPTIMAL
// SORTING+TWO POINTERUSING WHILE LOOP

// BRUTE FORCE

#include <iostream>
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int cnt=0;
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){                   // Whenever a problem asks for unique pairs (a, b) in an array, setting your inner loop to j = i + 1 is the standard way to guarantee you only look forward and never double-count!
            if((arr[i]+arr[j])%2==0){            // i!=j was not sufficient to handle duplicate pairs here 
                cnt++;
            }
        }
    }
    cout<<cnt<<endl;

    return 0;
}
