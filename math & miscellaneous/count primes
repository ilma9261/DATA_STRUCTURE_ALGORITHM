// leetcode 204

// THESE FIRST TWO WILL GIVE TLE
//1
class Solution {
public:

    bool isPrime(int num) {
        if(num<=1){
            return false;
        }

        for(int i=2;i<=sqrt(num);i++){
            if(num%i==0){
                return false;
            }
        }

        return true;
    }

    int countPrimes(int n) {
        if(n<=1){
            return 0;
        }

        int count=0;

        for(int i=2;i<n;i++){
            if(isPrime(i)){
                count++;
            }
        }

        return count;
    }
};

// 2
class Solution {
public:
    int countPrimes(int n) {
        int cnt=0;
        int l=2;
        int r=n;

        if(r<2){
            return 0;
        }

        while(l<r){
            bool isPrime=true;

            for(int i=2;i*i<=l;i++){
                if(l%i==0){
                    isPrime=false;
                    break;
                }
            }

            if(isPrime==true){
                cnt++;
            }

            l++;
        }

        return cnt;
    }
};

