// OPTIMAL(Sieve of Eratosthenes)

// TLE

class Solution {
public:
    int countPrimes(int n) {
        int cnt=0;
          if(n<=2){
            return 0;
        }

        vector<char> isComposite(n,false);        // Create a vector of n boolean values, and initialize all of them to false.
        for(int i=2;i*i<=n;i++){
            if(isComposite[i]==true){          // (isComposite)
                continue;                      // (!isComposite)
            }
            else{
                for(int j=i*i;j<n;j+=i){
                    isComposite[j]=true;
                }
            }
        }
        for(int i=2;i<n;i++){
            if(isComposite[i]==false){           
                cnt++;
            }
        }
        return cnt;
    }
};
