class Solution {
public:
    int reverse(int x) {
        int ans=0;
        while(x!=0){                //to handle negative as well 
            int digit=x%10;
            ans=ans*10+digit;
            x=x/10;
        }
        return ans;
    }
};


class Solution {
public:
    int reverse(int x) {
        long long ans=0;
        while(x!=0){
            int digit=x%10;
            ans=ans*10+digit;
             if(ans>INT_MAX || ans<INT_MIN){
                return 0;
            }
            x=x/10;
        }
        return ans;
    }
};
