// power of two

class Solution {
public:
    bool isPowerOfTwo(int n) {
        if(n==1){
            return true;
        }
        if(n<=0 || n%2!=0){
            return false;
        }
        else{
            return  isPowerOfTwo(n/2);
        }
        return false;
    }
};

