class Solution {
  public:
    void Addition(vector<vector<int>>& matrixA, vector<vector<int>>& matrixB) {
        
        int n=matrixA.size();       //rows
        int m=matrixA[0].size();     //column

//Take the first row (matrixA[0]).
//Count how many elements are in that row.
//Since every row in a matrix has the same number of columns, the number of elements in the first row equals the number of columns.

        for(int i=0;i<n;i++){          // loop goes through each row
            for(int j=0;j<m;j++){      // loop goes through each colomn
                matrixA[i][j]=matrixA[i][j]+matrixB[i][j];
            }
        }
    }
};
