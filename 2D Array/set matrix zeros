// leetcode 73

class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
         bool firstRow=false;
       bool firstCol=false; 
       int m=matrix.size();
       int n=matrix[0].size();
       for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(matrix[i][j]==0){
                if(i==0){
                    firstRow=true;
                }
                if(j==0){
                    firstCol=true;
                }
                matrix[i][0]=0;
                matrix[0][j]=0;
            }
        }
       }
       for(int i=1;i<m;i++){
        for(int j=1;j<n;j++){
            if(matrix[i][0]==0 || matrix[0][j]==0){
                matrix[i][j]=0;
            }
        }
       }
       if(firstCol==true){         // If the original first column contained at least one zero, execute the code inside these curly braces. 
       // you can simply write if(firstCol){}
        for(int i=0;i<m;i++){
            matrix[i][0]=0;
        }
       }
       if(firstRow==true){
        for(int j=0;j<n;j++){
            matrix[0][j]=0;
        }
       }
    }
};
