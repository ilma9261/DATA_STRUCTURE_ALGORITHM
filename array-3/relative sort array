// leetcode 1122
// it can be optmised more using the counting sort 

class Solution {
public:
    vector<int> relativeSortArray(vector<int>& arr1, vector<int>& arr2) {
        vector<int> v;
        unordered_map<int,int> mp;
        for(int i=0;i<arr1.size();i++){
            mp[arr1[i]]++;
        }
        for(int i=0;i<arr2.size();i++){
            while(mp[arr2[i]]>0){
                v.push_back(arr2[i]);
                mp[arr2[i]]--;
            }
        }
        vector<int> temp;
        for(auto x:mp){
            while(x.second>0){
                temp.push_back(x.first);
                x.second--;
            }
        }
        sort(temp.begin(),temp.end());
        for(int i=0;i<temp.size();i++){
            v.push_back(temp[i]);
        }
        return v;
    }
};
