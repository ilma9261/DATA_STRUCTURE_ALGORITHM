// leetcode 1431

class Solution {
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) {
        int largest=candies[0];
        int n=candies.size();
        for(int i=0;i<n;i++){
            if(candies[i]>largest){
                largest=candies[i];
            }
        }
        vector<bool> v;
        for(int i=0;i<n;i++){
            if(candies[i]+extraCandies>=largest){
                v.push_back(true);
            }
            else{
                v.push_back(false);
            }
        }
        return v;
    }
};
