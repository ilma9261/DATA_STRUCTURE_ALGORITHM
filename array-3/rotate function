// leetcode 396

class Solution {
public:
    int maxRotateFunction(vector<int>& nums) {
        long long n = nums.size();

        long long sum = 0;
        long long F = 0;

        for(int i = 0; i < n; i++) {
            sum += nums[i];
            F += i*nums[i];
        }

        long long result = F;

        for(int i = 0;i < n; i++) {
            long long newF = F + sum - n*nums[n-1-i];

            result = max(result, newF);

            F = newF;
        }

        return result;
    }
};
