// leetcode 896
// this type of approach is not passing all the test cases

class Solution {
public:
    bool isMonotonic(vector<int>& nums) {
        int n=nums.size();
        // edge case is impportant here

    if(n<=2){
        return true;
    }
        if(nums[0]>=nums[1]){
            for(int i=0;i<n-1;i++){
                if(nums[i]<nums[i+1]){
                    return false;
                }
            }
        }
        else{
              for(int i=0;i<n-1;i++){
                if(nums[i]>nums[i+1]){
                    return false;
                }
            }
        }
        return true;
    }
};

// correct approach for passing all the test cases

class Solution {
public:
    bool isMonotonic(vector<int>& nums) {
        int n=nums.size();
      bool increasing =false;
      bool decreasing =false;
for(int i=0;i<n-1;i++){
    if(nums[i]<nums[i+1]){
        increasing=true;
    }
    if(nums[i]>nums[i+1]){
        decreasing=true;
    }
}
if(increasing==true && decreasing==true){
    return false;
}
else{
    return true;
}
    }
};
