// leetcode 1773

class Solution {
public:
    int countMatches(vector<vector<string>>& items, string ruleKey, string ruleValue) {
        int n=items.size();
        int ans=0;
        int index=0;
        if(ruleKey=="type"){
            index=0;
        }
        else if(ruleKey=="color"){
            index=1;
        }
       else{
            index=2;
        }

        for(int i=0;i<n;i++){
            if(items[i][index]==ruleValue){
                ans++;
            }
        }
        return ans;
    }
};
