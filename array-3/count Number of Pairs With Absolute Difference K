// leetcode 2006

// BRUTE FORCE

class Solution {
public:
    int countKDifference(vector<int>& nums, int k) {
        int n=nums.size();
      int cnt=0;
      for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            int sum=abs(nums[i]-nums[j]);
            if(sum==k){
             cnt++;
            }
        }
      }
        return cnt;
    }
};

// OPTIMAL

class Solution {
public:
    int countKDifference(vector<int>& nums, int k) {
        int n=nums.size();
      int cnt=0;
      unordered_map<int,int> mp;
      for(int i=0;i<n;i++){
      int m=nums[i]-k;
      int n=nums[i]+k;
      if(mp.find(m)!=mp.end()){
        cnt+=mp[m];
      }
       if(mp.find(n)!=mp.end()){
        cnt+=mp[n];
      }
     mp[nums[i]]++;
      }
        return cnt;
    }
};
