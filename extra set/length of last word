// leetcode 58

// 1

class Solution {
public:
    int lengthOfLastWord(string s) {
        int n=s.size();
        int ans=0;
        for(int i=n-1;i>=0;i--){
            if(s[i]!=' '){
                ans++;
            }
            else if(ans!=0 && s[i]==' '){
                return ans;
            }
        }
        return ans;
    }
};

// 2


class Solution {
public:
    int lengthOfLastWord(string s) {
        stringstream ss(s);
        string word;
        string lastWord = "";

        while(ss >> word) {
            lastWord = word;
        }

        int ans = lastWord.size();
        return ans;
    }
};
