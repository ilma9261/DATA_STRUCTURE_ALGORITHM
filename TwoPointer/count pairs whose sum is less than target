// leetcode 2824

// OTIMAL
// SORTING+TWO POINTER

class Solution {
public:
    int countPairs(vector<int>& nums, int target) {
        sort(nums.begin(), nums.end());
        int i = 0;
        int j = nums.size() - 1;
        int cnt = 0;
        
        while (i < j) {
            int sum = nums[i] + nums[j];
            
            if (sum < target) {
                // Since the array is sorted, every element between 'i' and 'j'
                // paired with nums[i] will also have a sum < target
                cnt += (j - i);
                i++; // Move left pointer rightward to check larger values
            } else {
                j--; // Sum is too large or equal to target, reduce right pointer
            }
        }
        
        return cnt;
    }
};


// BRUTE FORCE

class Solution {
public:
    int countPairs(vector<int>& nums, int target) {
        int n=nums.size();
         int cnt=0;
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){                   // Whenever a problem asks for unique pairs (a, b) in an array, setting your inner loop to j = i + 1 is the standard way to guarantee you only look forward and never double-count!
            if((nums[i]+nums[j])<target){            // i!=j was not sufficient to handle duplicate pairs here 
                cnt++;
            }
        }
    }
    return cnt;
    }
};
