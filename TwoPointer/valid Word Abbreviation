// neetcode 

class Solution {
public:
    bool validWordAbbreviation(string word, string abbr) {
        int i=0;
        int j=0;
        while(i<word.size() && j<abbr.size()){
            if(isalpha(abbr[j])){
                if(word[i]!=abbr[j]){
                    return false;
                }
                else{
                    i++;
                    j++;
                }
            }
            else{
                if(abbr[j]=='0'){
                    return false;
                }
                int num=0;
                while(j<abbr.size() && isdigit(abbr[j])){
                    num=num*10+(abbr[j]-'0');               // We do this to convert a digit character into its actual integer value.
                    j++;
                }
                i+=num;
            }
        }
       if(i==word.size() && j==abbr.size()){
        return true;
       }
       else{
        return false;
       }
    }
};
