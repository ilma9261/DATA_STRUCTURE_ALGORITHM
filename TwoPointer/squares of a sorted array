// leetcode 977

class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
       int n=nums.size();
       int i=0;
       int j=n-1; 
       vector<int> v(n);
      // Compare the two ends → larger square goes at the back → move that pointer.
      int k=n-1;
       while(i<=j){                        // i<=j not i<j otherwise cases will fail here
        if(abs(nums[i])>abs(nums[j])){
            v[k]=nums[i]*nums[i];
            i++;
        }
        else{
            v[k]=nums[j]*nums[j];
            j--;
        }
        k--;
       }
       return v;
    }
};
