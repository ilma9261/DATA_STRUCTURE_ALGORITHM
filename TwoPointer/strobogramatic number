// leetcode prime

#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int main()
{
    string s;
    cin>>s;
  unordered_map<char, char> mp = {{'0', '0'}, {'1', '1'}, {'6', '9'}, {'8', '8'}, {'9', '6'}};
    int n=s.size();
    int i=0;
    int j=n-1;
    while(i<=j){                // use <= for safety 
     if(mp.find(s[i])==mp.end() || s[i]!=mp[s[j]] || s[j]!=mp[s[i]]){
         cout<<"false";
         return 0;
     }  
     else{
         i++;
         j--;
     }
    }
    cout<<"true";
    return 0;
}
