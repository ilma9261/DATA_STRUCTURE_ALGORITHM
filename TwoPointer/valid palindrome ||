// leetcode 680

class Solution {
public:
bool delCharacter(int i,int j,string s){
    while(i<=j){
            if(s[i]!=s[j]){
                return false;
            }
            else{
                i++;
                j--;
            }
        }
        return true;
}
    bool validPalindrome(string s) {
        int n=s.size();
        int i=0;
        int j=n-1;
        while(i<=j){
            if(s[i]!=s[j]){
              return delCharacter(i+1,j,s) ||  delCharacter(i,j-1,s);
            }
            else{
                i++;
                j--;
            }
        }
        return true;
    }
};
