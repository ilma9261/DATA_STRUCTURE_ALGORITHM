// leetcode 2486

class Solution {
public:
    int appendCharacters(string s, string t) {
        int i=0;
        int j=0;
        int cnt=0;
        while(i<s.size() && j<t.size()){               // cant compare two unrelated substrings  while(i<=j)
            if(s[i]!=t[j]){
                i++;
            }
            else{
                cnt++;
                i++;
                j++;
            }
        }
        int num=t.size()-cnt;
        return num;
    }
};
