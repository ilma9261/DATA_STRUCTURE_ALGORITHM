// leetcode 123

class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        vector<int> left(n,0);
        vector<int> right(n+1,0);
        int mini=prices[0];
        for(int i=1;i<n;i++){
            mini=min(mini,prices[i]);
            int profit=prices[i]-mini;
            left[i]=max(left[i-1],profit);
        }
        int maxi=prices[n-1];
        for(int i=n-2;i>=0;i--){
            maxi=max(maxi,prices[i]);
            int profit=maxi-prices[i];
            right[i]=max(right[i+1],profit);
        }
        int ans=0;
        for(int i=0;i<n;i++){
            int profit=left[i]+right[i+1];
            ans=max(ans,profit);
        }
        return ans;
    }
};
