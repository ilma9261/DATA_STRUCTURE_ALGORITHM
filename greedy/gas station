// leetcode 134

class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
       int totalGas=0;
       int totalCost=0;
       for(int i=0;i<gas.size();i++){
        totalGas+=gas[i];
        totalCost+=cost[i];
       }
       if( totalGas< totalCost){
        return -1;
       }
       int curr=0;
       int start=0;
       for(int i=0;i<gas.size();i++){
        curr+=gas[i]-cost[i];
        if(curr<0){
            start=i+1;            // The main difference is that i++ changes the actual value of i, whereas i + 1 does not.           
            curr=0;                // start++ → Increase start by 1.
                                      i++ → Increase i by 1.
                                      start = i + 1 → Make start equal to the next index of i.
        }
       }
       return start;
    }
};
