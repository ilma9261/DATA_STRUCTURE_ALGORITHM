// leetcode 135

class Solution {
public:
    int candy(vector<int>& ratings) {
        int n=ratings.size();
        vector<int> v(n,1);

        // Left to right: compare with left neighbour
        for(int i=1;i<n;i++){
            if(ratings[i]>ratings[i-1]){
                v[i]=v[i-1]+1;
            }
        }
        // Right to left: compare with right neighbour
         for(int i=n-2;i>=0;i--){
            if(ratings[i]>ratings[i+1]){
                v[i]=max(v[i],v[i+1]+1);
            }
         }
         int total=0;
         for(int i=0;i<n;i++){
            total+=v[i];
         }
         return total;
    }
};
