// leetcode 45

class Solution {
public:
    int jump(vector<int>& nums) {
        int n=nums.size();
        int reach=0;
        int jump=0;
        int curr=0;
         for(int i=0;i<n-1;i++){
        // Update maximum reachable index
          reach = max(reach, i + nums[i]);
          if(i==curr){
            jump++;
            curr=reach;
          }
        }
        return jump;
    }
};
