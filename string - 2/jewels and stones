// leetcode 771

class Solution {
public:
    int numJewelsInStones(string jewels, string stones) {
        unordered_set<char> st;
        for(int i=0;i<jewels.size();i++){
           st.insert(jewels[i]);
        }
        int cnt=0;
        for(int i=0;i<stones.size();i++){
            if(st.find(stones[i])!=st.end()){
                cnt++;
            }
        }
        return cnt;
    }
};
