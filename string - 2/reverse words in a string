// leetcode 151 && leetcode 557

class Solution {
public:
    string reverseWords(string s) {
        reverse(s.begin(),s.end());
        string ans="";
        for(int i=0;i<s.size();i++){
            string word="";
            while(i<s.size() && s[i]!=' '){
                word+=s[i];
                i++;
            }
            if(word!=""){
                reverse(word.begin(),word.end());
                ans+=' ' + word;
            }
        }
        return ans.substr(1);               // string.substr(start, length);
    }
};


class Solution {
public:
    string reverseWords(string s) {
        int i=0;
        int n=s.size();
        string ans="";
        while(i<n){
             string word="";
             while(i<n && s[i]!=' '){
                word+=s[i];
                i++;
             }
             if(word!=""){
                reverse(word.begin(),word.end());
                ans+=' ' + word;
             }
             i++;
        }
         return ans.substr(1); 
    }
};
