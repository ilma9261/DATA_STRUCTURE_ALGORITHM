// leetcode 387

// SPACE IS NOT OPTIMISED

lass Solution {
public:
    int firstUniqChar(string s) {
        int n=s.size();
        unordered_map<char,int> mp;
        for(int i=0;i<n;i++){
           mp[s[i]]++;
        }
        for(int i=0;i<n;i++){
          if(mp[s[i]]==1){
            return i;
          }
        }
        return -1;
    }
};


// OPTIMAL

class Solution {
public:
    int firstUniqChar(string s) {
        int n = s.size();
        int count[26] = {0};

        // Step 1: Count frequency of each character
        for(int i = 0; i < n; i++) {
            count[s[i] - 'a']++;
        }

        // Step 2: Find the first character with frequency 1
        for(int i = 0; i < n; i++) {
            if(count[s[i] - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
};
