// NOT OPTIMAL 

class Solution {
  public:
    char nonRepeatingChar(string &s) {
        //  code here
        int n=s.size();
        unordered_map<char,int> mp;
        char res='$';
        for(int i=0;i<n;i++){
            mp[s[i]]++;
        }
        for(int i=0;i<n;i++){
            if(mp[s[i]]==1){
                res=s[i];
                return res;
            }
        }
        return res;
    }
};


// OPTIMAL

class Solution {
  public:
    char nonRepeatingChar(string &s) {
        //  code here
        int n=s.size();
        vector<int> freq(26, 0);

                // Pass 1: Count frequency of each character
                for (int i=0;i<n;i++) {
                    freq[s[i] - 'a']++;
                }

                // Pass 2: Find the first character with frequency 1
                for (int i=0;i<n;i++) {
                    if (freq[s[i] - 'a'] == 1) {
                        return s[i];
                    }
                }

                // If no non-repeating character exists
                return '$';
    }
};
