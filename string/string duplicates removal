class Solution {
public:
    string removeDuplicates(string &s) {
        string res="";
        unordered_set<char> st;

        for(int i=0;i<s.size();i++){
            if(st.find(s[i])==st.end()){
                res+=s[i];
                st.insert(s[i]);
            }
        }
        return res;
    }
};

