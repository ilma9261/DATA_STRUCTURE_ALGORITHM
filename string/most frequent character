// NOT OPTIMAL

class Solution {
  public:
    char getMaxOccuringChar(string& s) {
        //  code here
    unordered_map<char,int> mp;
    for(int i=0;i<s.size();i++){
        mp[s[i]]++;
    }
    char maxoccur=s[0];
    for(int i=0;i<s.size();i++){
       if(mp[s[i]]>mp[maxoccur]){
           maxoccur=s[i];
       }
       else if(mp[s[i]]==mp[maxoccur] && s[i]<maxoccur){
           maxoccur=s[i];
       }
    }
   return maxoccur; 
}
};
    

// OPTIMAL

// GFG
// Frequency array approach

class Solution {
  public:
    char getMaxOccuringChar(string& s) {
        int n = s.size();
        int count[26] = {0};

        // Step 1: Count frequency of each character
        for(int i=0; i<n; i++){
            count[s[i]-'a']++;
        }

        // Step 2: Find character with maximum frequency
        int maxFreq = 0;
        char maxoccur = 'a';

        for(int i=0; i<26; i++){
            if(count[i] > maxFreq){
                maxFreq = count[i];
                maxoccur = 'a' + i;
            }
        }

        return maxoccur;
    }
};
