class Solution {
  public:
    vector<string> smallerAndLarge(string &s) {
        // code here
        int n=s.size();
        vector<string> v;
        string max="";
        string min="";
        string word="";
        for(int i=0;i<n;i++){
            if(s[i]!=' '){
                word+=s[i];
            }
            else{
                if(word.size()>=max.size()){
                    max=word;
                }
                 if(min=="" || word.size()<min.size() ){
                    min=word;
                }
                word="";
            }
        }
        if(word.size()>=max.size()){
            max=word;
        }
        if(min=="" || word.size()<min.size()){
            min=word;
        }
        v.push_back(min);
        v.push_back(max);
        return v;
    }
};
