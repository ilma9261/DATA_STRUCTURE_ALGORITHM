class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.size()!=t.size()){
            return false;
        }
        // 1. Declare and initialize 26 frequency buckets to 0
        int count[26]={0};
        for(int i=0;i<s.size();i++){
            count[s[i]-'a']++;         // s[i] - 'a' converts a character into a bucket index (0 to 25)
            // example - a' - 'a' = 0 (Bucket 0)   and 'b' - 'a' = 1 (Bucket 1)
            count[t[i]-'a']--;
        }
        // 3. Check if all buckets returned to zero
        for(int i=0;i<26;i++){
            if(count[i]!=0){
                return false ;
            }
        }
        return true;
    }
};
