// leetcode 2042

class Solution {
public:
    bool areNumbersAscending(string s) {
        int mini=INT_MAX;
        int index=0;
        for(int i=0;i<s.size();i++){
            if(isdigit(s[i])){
                   // stoi() → String to Integer.
                                   // s[i] - '0' → Character digit to Integer.
                int num=0;
             // Extract the complete number
                while(i < s.size() && isdigit(s[i])) {

                    num = num * 10 + (s[i] - '0');
                    i++;
                }
                mini=num;
                index=i;
                break;
                }
        }
        for(int i=index+1;i<s.size();i++){
        if(isdigit(s[i])){
            int num=0;
             // Extract the complete number
                while(i < s.size() && isdigit(s[i])) {

                    num = num * 10 + (s[i] - '0');
                    i++;
                }
                if(num<=mini){
            return false;
        }
        else{
            mini=num;
        }
        }
        }
        return true;
    }
};
