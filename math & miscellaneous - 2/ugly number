// leetcode 263

class Solution {
public:
    bool isUgly(int n) {
        if(n<1){
            return false;
        }
        while(n!=1){
            if(n%2==0){
                n=n/2;
            }
            else if(n%3==0){
                n=n/3;
            }
            else if(n%5==0){
                n=n/5;
            }
            else{
                break;           // if n is not divisible by any of these numbers so while loop never terminates so we need to add break 
            }
        }
        if(n==1){
            return true;
        }
        else{
            return false;
        }
    }
};
