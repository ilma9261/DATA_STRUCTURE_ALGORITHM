// leetcode 2443

class Solution {
public:
    bool sumOfNumberAndReverse(int num) {
        if(num==0){
            return true;
        }
        for(int i=0;i<num;i++){
            string temp=to_string(i);          // declare temp as string cz u r changing it in string no matter it was int before 
            reverse(temp.begin(),temp.end());
            if(stoi(temp)+i==num){
                return true;
            }
        }
        return false;
    }
};
