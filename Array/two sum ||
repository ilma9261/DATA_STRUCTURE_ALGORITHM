//leetcode 167
// LeetCode 1. Two Sum and 167. Two Sum II – Input Array Is Sorted are almost the same problem, but the main difference is whether the array is sorted or not.

class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        
        int i = 0;
        int j = numbers.size() - 1;
        
        while (i < j) {
            int sum = numbers[i] + numbers[j];
            
            if (sum == target) {
                return {i+1, j+1};  // 1-based indexing
            }
            else if (sum < target) {
                i++;
            }
            else {
                j--;
            }
        }
        
        return {};
    }
};
